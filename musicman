# the terminal likes to auto update the COLUMNS and LINES variables
# but i found that to be unreliable and rether work with my own 
get_vars() {
	tLINES=$1 
	tCOLUMNS=$(($2-1))
}
get_terminal_size() {
#    read -r LINES COLUMNS < <(stty size)
	get_vars $(stty size)
	((max_line=tLINES - 8))
}


clear_screan() {
	printf '\e[%sH\e[1J' $tLINES
}

# lifted directly out of fff
setup_terminal() {
	# Setup the terminal for the TUI.
	# '\e[?1049h': Use alternative screen buffer.
	# '\e[?7l':    Disable line wrapping.
	# '\e[2J':     Clear the screen.
	# '\e[1;Nr':   Limit scrolling to scrolling area.
	#              Also sets cursor to (0,0).
	printf '\e[?1049h\e[?7l\e[2J\e[1;%sr' "$max_items"
}

reset_terminal() {
	# Reset the terminal to a useable state (undo all changes).
	# '\e[?7h':   Re-enable line wrapping.
	# '\e[2J':    Clear the terminal.
	# '\e[;r':    Set the scroll region to its default value.
	#             Also sets cursor to (0,0).
	# '\e[?1049l: Restore main screen buffer.
	printf '\e[?7h\e[2J\e[;r\e[?1049l'
}




resized() {
	get_terminal_size
	clear_screan
	update_title_bar
	update_song_bar
	update_tab_bar
	update_vol_bar
	print_page
}
read_stats() {
	TAB=$(cat "$MM_HOME/tab" 2>/dev/null)
	TAB=${TAB%%[!0-9]*}	# Remove everything after first non-digit
	TAB=${TAB:-0}		# Default to 0 if empty
}

read_artists() {
	artist_list=("$MUSICDIR"/*)
}

read_albums() {
	album_list=("$MUSICDIR"/*/*)
	album_display_list=("${album_list[@]#$MUSICDIR/}")
	album_display_list=("${album_display_list[@]/\// - }")
}

read_songs() {
	song_list=("$MUSICDIR"/*/*/*.mp3)
	song_display_list=("${song_list[@]#$MUSICDIR/}")
	song_display_list=("${song_display_list[@]/\/*\// - }")
}


print_line() {
	if [[ $1 == $cursor_item ]] ; then
		color_code="\e[${CURSOR_FG:=30};${CURSOR_BG:=41}m"
	else 
		unset color_code
	fi

	printf "\e[$(($1+cmd_position+1-scroll))H${color_code}%3d    %s\e[m\e[K\r" \
		$(($1+1)) "${display_list[$1]}"
}

display_update() {
	printf '\e[7H'
	for i in $(seq 0 $(($max_line < "${#display_list[@]}"-1 ? \
		$max_line : "${#display_list[@]}"-1)) )
	do
		print_line $((i+scroll))
	done
	printf '\e[6H'
}

print_page() {
	clear_screan
	echo "$TITLE_BAR$SONG_BAR$TIME_BAR$VOL_BAR$TAB_BAR"
	case $TAB in
		0) 
			display_list=("${artist_list[@]#$MUSICDIR/}")
			display_update
			;;
		1) 
			display_list=("${album_display_list[@]}")
			display_update
			;;
		2) 
			display_list=("${song_display_list[@]}")
			display_list=("${display_list[@]%.mp3}")
			display_update
			;;

		*) true ;;
	esac
}



# this part is mostly escape code wizardry
# we bake the variables and echo them when we need to
update_tab_bar(){ 
	local code0="\e[${fg0:=37};${TAB_BAR_BG:=44}m"
	local code1="\e[${fg1:=37};${bg1:=105}m"
	local aritst_tab=" ${code0} artist"
	local album_tab=" ${code0} album"
	local song_tab=" ${code0} song"
	case $TAB in
		0) aritst_tab=" ${code1}>artist" ;;
		1) album_tab=" ${code1}>album" ;;
		2) song_tab=" ${code1}>song" ;;
	esac

	local str="${aritst_tab}${album_tab}${song_tab}"
	TAB_BAR=$(printf "\e[%sH${code0}%*s\r%s ${str}\e[m" \
		"${tab_bar_position}" "$tCOLUMNS" "|" "" )
}

update_title_bar() {
	local code0="\e[${MM_TITLE_FG:=31};${MM_TITLE_BG:=40}m"
	local len="${#MM_TITLE}"
	local spaces=$(( (tCOLUMNS-len) / 2 ))
	
	TITLE_BAR=$(printf "\e[%sH${code0}%*s%s%*s" \
		"$title_bar_position" "$spaces" "" "$MM_TITLE" $((tCOLUMNS-spaces-len)) ""
	)
}

update_song_bar() {
	local code0="\e[${MM_SONG_FG:=34};${MM_SONG_BG:=40}m"

	SONG_BAR=$(printf "\e[%sH${code0}%*s\r%s" \
		"$song_bar_position" "$tCOLUMNS" "" "$display_format")
}

update_vol_bar() {
	local code2="\e[${fg2:=31};${MM_VOLBAR_EMPTY_BG:=100}m"
	local code3="\e[${fg3:=37};${bg3:=42}m"
	local filled=$(($tCOLUMNS*${volume:-50}/100))

	VOL_BAR=$( printf "\e[%sH$code2%*s\r$code3%*s\r %s\e[m" \
		"$vol_bar_position" "$(($tCOLUMNS))" '|' "$filled" '|' "$volume")
}

update_time_bar() {
	[[ -f $TIMEFILE ]] && time=$(<$TIMEFILE)
	[[ -z $time ]] && return
	local code2="\e[${fg2:=34};${MM_SEEKBAR_EMPTY_BG:=40}m"
	local code1="\e[${fg3:=37};${MM_SEEKBAR_FILED_BG:=44}m"
	time_bar_filled=$(($tCOLUMNS*$time/$maxtime))

	TIME_BAR=$( printf "\e[%sH$code2%*s\r$code1%*s\r ${time}\e[m" \
		"$time_bar_position" "$(($tCOLUMNS))" '|' "$time_bar_filled" '|')
}

update_time_bar() {
    [[ -f $TIMEFILE ]] && time=$(<"$TIMEFILE")
    [[ -z $time ]] && return

	local min=$((time / 60))
	local sec=$((time % 60))
	printf -v t '%d:%02d' "$min" "$sec"
    local filled=$((tCOLUMNS * time / maxtime))
    local pos=$(((tCOLUMNS - ${#t}) / 2))

    # build plain bar
    local bar
    printf -v bar '%*s' "$tCOLUMNS" '|'

    # inject time
    bar="${bar:0:pos}${t}${bar:pos+${#t}}"

    # split at fill boundary
    local left="${bar:0:filled}"
    local right="${bar:filled}"

    TIME_BAR=$(printf '\e[%sH\e[%s;%sm%s\e[%s;%sm%s\e[m' \
        "$time_bar_position" \
        "${fg3:-37}" "${MM_SEEKBAR_FILED_BG:-44}" "$left" \
        "${fg2:-34}" "${MM_SEEKBAR_EMPTY_BG:-40}" "$right")
}


# this is for the data that changes once whenever the song changes
song_status_check() {
	[[ -f "$FILEPATHFILE" && "$file_path" != "$(<$FILEPATHFILE)" ]] && {

		display_format="playing : $(<$NAMEFILE) - $(<$ARTISTFILE) - $(<$ARLBUMFILE)"
		[[ -f $MAXTIMEFILE ]] && maxtime=$(<$MAXTIMEFILE)
		[[ -z $maxtime ]] && maxtime=100
		file_path=$(<$FILEPATHFILE)

		update_song_bar
		echo "$SONG_BAR"
	}
}
