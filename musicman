cursor_up() {
	((cursor_item <= 0)) && return

	((cursor_item--)) 
	((cursor_item<scroll)) &&
		((scroll--))

	if ((scroll==cursor_item)); then
		((scroll==0)) && {
			print_line $cursor_item
			print_line $(($cursor_item+1))
			return
		}
		printf '\e[L'
		print_line $cursor_item
		print_line $(($cursor_item+2))
		print_line $(($cursor_item+1))
	else
		print_line $cursor_item
		print_line $(($cursor_item+1))
	fi
	case $TAB in
		0)
			t0cursor_item=$cursor_item
			t0scroll=$scroll
			;;
		1)
			t1cursor_item=$cursor_item
			t1scroll=$scroll
			;;
		2)
			t2cursor_item=$cursor_item
			t2scroll=$scroll
			;;
		*)
			exit 40
			;;
	esac
}

cursor_down() {
	local max_items=$((${#display_list[@]}-1))
	((cursor_item >= max_items)) && return


	((cursor_item++)) 
	print_line $(($cursor_item-1))
	((cursor_item>max_line+scroll)) &&
		((scroll++))
	printf '\n\n'
	print_line $cursor_item
	echo "$TITLE_BAR$SONG_BAR$TIME_BAR$VOL_BAR$TAB_BAR"


	case $TAB in
		0)
			t0cursor_item=$cursor_item
			t0scroll=$scroll
			;;
		1)
			t1cursor_item=$cursor_item
			t1scroll=$scroll
			;;
		2)
			t2cursor_item=$cursor_item
			t2scroll=$scroll
			;;
		*)
			exit 40
			;;
	esac
	printf "\e[$cmd_positionH"
}

go_tab() {
	case "$1" in 
		'+') go_tab $(($TAB+1)) && return 0 ;;
		'-') go_tab $(($TAB-1)) && return 0 ;;
		0)
			cursor_item=$t0cursor_item
			scroll=$t0scroll
			;;
		1)
			cursor_item=$t1cursor_item
			scroll=$t1scroll
			;;
		2)
			cursor_item=$t2cursor_item
			scroll=$t2scroll
			;;
		*) ;;
	esac

	(( 0 > "$1" || "$1" > 2 )) && return 0

	TAB=$1
	echo $TAB > $MM_HOME/tab
	update_tab_bar
	print_page
}

select_item() {
	case "$TAB" in
		0)
			album_list=( "${artist_list[$1]}"/* )
			album_display_list=("${album_list[@]##*/}")
			t1cursor_item=0 
			t1scroll=0 
			go_tab 1
			;;
		1)
			song_list=( "${album_list[$1]}"/*.mp3 )
			song_display_list=( "${song_list[@]#*/*:}" )
			t2cursor_item=0
			t2scroll=0 
			go_tab 2
			;;
		2)
			musicman-daemon enqueue $(($1+1)) "${song_list[@]}" &> /dev/null &
			;;
		*)
			command ...
			;;
	esac
}

select_all() {
	case "$TAB" in
		0)
			read_albums
			t1cursor_item=0 
			t1scroll=0 
			go_tab 1
			;;
		1)

			song_list=()
			for a in "${album_list[@]}"; do
				song_list+=( "$a"/*.mp3 )
			done
			song_display_list=( "${song_list[@]#$MUSICDIR/}" )
			song_display_list=("${song_display_list[@]/\/*:/ - }")
			t2cursor_item=0
			t2scroll=0 
			go_tab 2
			;;
		2)
			~/scripts/MusicMan/player.sh  queue "${song_list[@]}" &> /dev/null &
			;;
		*)
			command ...
			;;
	esac
}


open_cmd(){
	if [[ $1 == '-n' ]]; then
		local mode=num
		shift
	fi
	for ((;;)); {
		printf "\e[${cmd_position}H%s%s " "$1" "$cmd_line"

        read "${read_flags[@]}" -srn 1 && 
		{
			char=$REPLY
			[[ "$REPLY" == $'\e' ]] && {
				read "${read_flags[@]}" -rsn 1

				# Handle a normal escape key press.
				[[ $'\e'${REPLY} == $'\e\e['* ]] &&
					read "${read_flags[@]}" -rsn 1 _

				char=$'\e'${REPLY}
			}

			case ${char:=$REPLY} in
				$'\177')
					local cmd_line=${cmd_line%?}
					;;
				'')
					last_cmd_reply="$cmd_line"
					printf '\e[1J'
					echo "$TAB_BAR"
					return 0
					;;
				*)
					if [[ $mode == 'num' && $char =~ ^[0-9]$ ]]; then
						local cmd_line=$cmd_line$char
					elif [[ $char != *[^[:print:]]* || mode != num ]]; then
						local cmd_line=$cmd_line$char
					fi
					;;
			esac
			# very chaotic indeed
		}
        [[ -t 1 ]] || exit 1
	}
}

command_change_title() {
	if [[ $TAB == 2 ]]; then
		get_tags "${song_list[$cursor_item]}"
		open_cmd 'new title: '
		change_track_title "$ARTIST" "$ALBUM" "$TRACK" "$TITLE" "$last_cmd_reply"
	elif [[ $TAB == 1 ]]; then
		open_cmd 'new title: '
		for i in "${album_list[$cursor_item]}"/*.mp3; do
			get_tags "$i" || 
				return $?

			set_song_meta "$i" "$ARTIST" "$last_cmd_reply" "$TRACK" "$TITLE" "$YEAR"
		done

		local artist_dir="${album_list[$cursor_item]%/*}"

		if [[ -d "$artist_dir/$last_cmd_reply" ]]; then
			mv "${album_list[$cursor_item]}"/* "$artist_dir/$last_cmd_reply"
			rm -rf "${album_list[$cursor_item]}"
		else 
			mv "${album_list[$cursor_item]}" "$artist_dir/$last_cmd_reply/"
		fi

	else
		printf "\e[${cmd_position}H%s " "no song is selected"
		read -sn 1 nul
	fi
}

run_command() {
	case "$1" in
		q) 
			exit 0 
			;;
		"chg tn")
			if [[ $TAB == 1 ]]; then
				local alb_path="${album_list[$cursor_item]}"
				local alb=${alb_path##*/}
				local art_path=${alb_path%/*}
				local art=${art_path##*/}

				reset_terminal
				change_album_order "$art" "$alb"
				setup_terminal
			elif [[ $TAB == 2 ]]; then
				get_tags "${song_list[$cursor_item]}"
				open_cmd -n 'give number '
				if [[ "$last_cmd_reply" =~ ^[0-9]+$ ]]; then
					change_track_no "$ARTIST" "$ALBUM" "$TRACK" "$TITLE" "$last_cmd_reply"
				else
					printf "\e[${cmd_position}H%s " "not a number"
					read -sn 1 nul
				fi
			else
				printf "\e[${cmd_position}H%s " "no song or album is elected"
				read -sn 1 nul
			fi
			;;
		"chg ti") command_change_title ;;
		*) : ;;
	esac
}

key() {
    # Handle special key presses.
    [[ $1 == $'\e' ]] && {
        read "${read_flags[@]}" -rsn 1

        # Handle a normal escape key press.
        [[ ${1}${REPLY} == $'\e\e['* ]] &&
            read "${read_flags[@]}" -rsn 1 _

        local special_key=${1}${REPLY}
    }

    case ${special_key:-$1} in
		q) exit 0 ;;
		d) go_tab + ;;
		a) go_tab - ;;
		s) 
			cursor_down
			printf "\e[${cmd_position}H"
			;;
		w) 
			cursor_up
			printf "\e[${cmd_position}H\r\e[K%s" ''
			;;
		e|$'\e ') 
			select_item $cursor_item
			;;
		'E')
			select_all
			;;
		
		c)
			open_cmd
			run_command "$last_cmd_reply"
			;;
		# playback Handle  VVV
		#
		$'\e2'|' ') musicman-daemon pause-play ;;
		$'\e1'|$'\es'|'S') 
			local v=$(($(cat $VOLFILE)-volume_step))
			volume=$(($v<0?0:$v))
			musicman-daemon vdown $volume_step
			update_vol_bar
			echo "$VOL_BAR"
			;;
		$'\e3'|$'\ew'|'W') 
			local v=$(($(cat $VOLFILE)+volume_step))
			volume=$(($v>100?100:$v))
			musicman-daemon vup $volume_step
			update_vol_bar
			echo "$VOL_BAR"
			;;
		$'\e5') musicman-daemon next ;;
		$'\e4') musicman-daemon prev ;;
		$'\ed'|'D') musicman-daemon forward ;;
		$'\ea'|'A') musicman-daemon backward ;;

		$'\ex') 
			musicman-daemon kill
			killall aplay
			;;
		*)
			true
	esac
}

tui() {
	mkdir -p $SHM_DIR
    ((BASH_VERSINFO[0] > 3)) &&
        read_flags=(-t 1)


	get_terminal_size
	setup_terminal
	read_artists
	read_albums
	read_songs
	read_stats
	[[ -f "$VOLFILE" ]] && volume=$(<$VOLFILE)
	update_title_bar
	update_song_bar
	update_tab_bar
	update_vol_bar
	update_time_bar
	print_page

	trap 'resized' WINCH

	while :; do
		read "${read_flags[@]}" -rsn1 && key "$REPLY"
        [[ -t 1 ]] || exit 1
		song_status_check
		update_vol_bar
		update_time_bar
		echo "$TIME_BAR"
		echo "$VOL_BAR"
		echo "$TAB_BAR"
	done
	reset_terminal
}
# ==============================================================================

[[ "$#" == 0 ]] &&
	tui


command="$1"
shift
case "$command" in
	'add-song') add_song "$@" ;;
	'vup') musicman-daemon vup;;
	'pause-play') musicman-daemon pause-play;;
	'vdown') musicman-daemon vdown;;
	*) echo WTF ;;
esac
