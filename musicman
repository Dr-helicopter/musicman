# archiving logic
# ==============================================================================
editor_song_meta() {
	echo "
# file ${1}
# edit the vars as you please

ARTIST='"${ARTIST:-$fallback_artist}"'
TITLE='${TITLE:-$(basename "$1")}'
ALBUM='"${ALBUM:-$fallback_album}"'
TRACK='${TRACK}'
" > "$TMPFILE"
	"${EDITOR:=vi}" "$TMPFILE"
}

change_album_order() {
	echo "$(
		printf "# album %s - %s\n" "${2}" "${1}"
		printf "#\n"

		for i in "${MUSICDIR}/${1}/${2}/"*.mp3 ; do
			get_tags "$i"
			printf '%s\t%s\n' "${TRACK}" "${i#$MUSICDIR/${1}/${2}/}"
		done
	)" > "$TMPFILE"
	"${EDITOR:=vi}" "$TMPFILE"

	while IFS= read -r line; do
		# skip blank lines
		[ -z "$line" ] && continue

		# skip comments
		case "$line" in
			\#*) continue ;;
		esac

		IFS='	' read -r number filename <<< "$line"
		filename="${MUSICDIR}/${1}/${2}/${filename}"

		if [[ -f "$filename" ]]; then
			get_tags "$filename"
			change_track_no "$ARTIST" "$ALBUM" "$TRACK" "$TITLE" "$number"
		fi
	done < "$TMPFILE"
}


open_song_editor() {
	editor_song_meta "$1"
	source "$TMPFILE"
	> "$TMPFILE"
}

format_prefix_number() {
	# the 10# stops the string from being interpreted as octal if it starts with 0
    [[ $1 =~ ^[0-9]+$ ]] &&
        printf "%02d" "$((10#$1))" ||
        echo "xx"
}

format_album_dir() {
	# we use substitution here to replace all instances of / with the unicode ∕
	# to prevent extra nesting in the archive dir

	local artist="${1////∕}"
	local album="${2////∕}"
	echo "$MUSICDIR/$artist/$album"
}

format_file_name() {
	# takes track as $1 and title as $2
	echo $(format_prefix_number "$1")":${2////∕}.mp3"
}


get_tags() {
	[[ ! -f "$1" ]] && return 1


	ARTIST='' TITLE='' ALBUM='' YEAR='' TRACK=''

	while IFS='=' read -r key value; do
        case "$key" in
			"TAG:artist")	ARTIST=$value ;;
            "TAG:title"	)	TITLE=$value ;;
            "TAG:album"	)	ALBUM=$value ;;
            "TAG:date"	)	YEAR=$value ;;
            "TAG:track"	)	TRACK=${value%%/*} ;;
        esac
	done < <(ffprobe -v quiet -show_entries \
		format_tags=artist,title,album,track,date \
        -of default=noprint_wrappers=1:nokey=0 "$1")

	[[ -z "$ARTIST" || -z "$ALBUM" || -z "$TITLE" ]] && return 2
	# if the above fails its gonna be last command
	# and the return value will be 1 (stupid ass language)
	return 0 
}


set_song_meta() {
	# takes file name as $1
	# and artist, album, track, title, date as $[2-6]
	[[ ! -f "$1" ]] && { echo "file $1 not found"; return 1; }

	local tmp_out="/tmp/tmp.mp3"
	local album_dir="${1%/*}"
	local album_cover="$album_dir/cover.jpg"
	local img_input=()

	# set cover if it exists
	[[ -f "$album_cover" ]] && img_input=(-i "$album_cover" -c:v mjpeg -map 1:v)


	ffmpeg -v quiet -y -i "$1" "${img_input[@]}" \
		-map_metadata -1 \
		-map_metadata:s:a -1 \
		-c:a copy -map 0:a \
		${2:+-metadata artist="$2"} \
		${3:+-metadata album="$3"} \
		${4:+-metadata track="$(format_prefix_number "$4")"} \
		${5:+-metadata title="$5"} \
		${6:+-metadata date="$6"} \
		-id3v2_version 3 \
		"$tmp_out"

	mv "$tmp_out" "$1"
}

merge_albums() { # artist $1 album $2 to artist $3 album $4
	[[ ! -d "$MUSICDIR/$1/$2" ]] && {
		echo album $2 doesnt exist
		return 1
	}

	[[ ! -d "$MUSICDIR/$3/$4" ]] && {
		echo album $4 doesnt exist
		return 1
	}


	for i in "$MUSICDIR/$1/$2"/* 
	do
		set_song_meta "$i" "$3" "$4" "" ""
		mv "$i" "$MUSICDIR/$3/$4"
	done
	rmdir "$MUSICDIR/$1/$2"
}


handle_cover_art() {
	local album_dir=$(format_album_dir "$ARTIST" "$ALBUM")
	local tmp_cover="$SHM_DIR/incoming_cover.jpg"

	# delete the cover file if it exists
	rm -f "$tmp_cover"

	ffmpeg -v quiet -i "$1" -an -c:v copy "$tmp_cover" -y 2>/dev/null
	[[ ! -s "$tmp_cover" ]] && return 0
	
	if [[ ! -f "$album_dir"/cover.jpg ]]; then
		mkdir -p "$album_dir"
		mv "$tmp_cover" "$album_dir"/cover.jpg
		return 0
	fi

	# exit if the covers match
	diff -q "$album_dir"/cover.jpg "$tmp_cover" &>/dev/null && 
		{ rm -f "$tmp_cover"; return 0; }

	# ask user if the covers conflict
	while :; do
		printf "\n cover art conflict found for %s - %s\n" "$ARTIST" "$ALBUM"
		printf "1) keep existing cover (force song to match album)\n"
		printf "2) overwrite cover with this song's cover\n"
		printf "3) Compare images using %s\n" "$IMGVIEWR"

		printf "Choice [1-3]: "
		read -rn1 choice
		echo ""

		case "$choice" in
			1)
				rm -f "$tmp_cover"
				break
				;;
			2)
				mv "$tmp_cover" "$album_dir"/cover.jpg
				break
				;;
			3)
				"$IMGVIEWR" "$album_dir"/cover.jpg "$tmp_cover" &
				;;
		esac
	done
}


change_track_no() {
	local album_dir=$(format_album_dir "$1" "$2")
	local filename=$(format_file_name "$3" "$4")

	local file_path="$album_dir/$filename"
	[[ ! -f "$file_path" ]] && {
		echo file $file_path doesnt exist
		return 1
	}


	# get tags else return 
	get_tags "$file_path" || 
		return $?

	TRACK="$5"


	local new_file_name="$album_dir/$(format_file_name "$TRACK" "$TITLE")"
	mv "$file_path" "$new_file_name"

	set_song_meta "$new_file_name" "$ARTIST" "$ALBUM" "$TRACK" "$TITLE" "$YEAR"
}


change_track_title() {
	# takes artist, album, track, title and new title as $[1-5]
	local album_dir=$(format_album_dir "$1" "$2")
	local filename=$(format_file_name "$3" "$4")

	local file_path="$album_dir/$filename"
	[[ ! -f "$file_path" ]] && {
		echo file $file_path doesnt exist
		return 1
	}

	
	# get tags else return 
	get_tags "$file_path" || 
		return $?

	TITLE="$5"


	local new_file_name="$album_dir/$(format_file_name "$TRACK" "$TITLE")"
	mv "$file_path" "$new_file_name"

	set_song_meta "$new_file_name" "$ARTIST" "$ALBUM" "$TRACK" "$TITLE" "$YEAR"
}

_add_song() {
	! get_tags "$1" && {
		[[ ! -f "$1" ]] && echo the file $1 isnt && return 1
		open_song_editor "$1"
	} || { [[ $2 = '-e' ]] && open_song_editor "$1"; }


	handle_cover_art "$1"

	local album_dir=$(format_album_dir "$ARTIST" "$ALBUM")
	local file_track=$(format_prefix_number "$TRACK")
	local file_name="$file_track:${TITLE////∕}.mp3"
	local file_path="$album_dir/$file_name"

	local img_input=()

	mkdir -p "$album_dir"

	[[ -f "$album_dir"/cover.jpg ]] && 
		img_input=(-i "$album_dir"/cover.jpg -c:v mjpeg -map 1:v)

	echo $ARTIST $ALBUM $TRACK $TITLE
	ffmpeg  -y -i "$1" "${img_input[@]}" \
		-map_metadata -1 \
		-map_metadata:s:a -1 \
		-c:a copy -map 0:a \
		-metadata artist="$ARTIST" \
		-metadata album="$ALBUM" \
		-metadata track="$file_track" \
		-metadata title="$TITLE" \
		-metadata date="$YEAR" \
		-id3v2_version 3 \
		"$file_path" \
		-v quiet || 
	ffmpeg -y -i "$1" "${img_input[@]}" \
        -map_metadata -1 \
        -map_metadata:s:a -1 \
		-c:a libmp3lame -q:a 2 -map 0:a \
        -metadata artist="$ARTIST" \
        -metadata album="$ALBUM" \
        -metadata track="$file_track" \
        -metadata title="$TITLE" \
        -metadata date="$YEAR" \
        -id3v2_version 3 \
        "$file_path" #-v quiet
}

add_song() {
	args=("$@")
	for i in $(seq "${#args[@]}"); do 
		case "${args[$i]}" in
			"-e") 
				unset "args[$i]" 
				eflag='-e' 
			;;
			-AR=*)
				fallback_artist="${args[$i]#-AR=}"
				unset "args[$i]"
			;;
			-AL=*)
				fallback_album="${args[$i]#-AL=}"
				unset "args[$i]"
			;;

		esac
	done
	set -- "${args[@]}"

	for i in "${args[@]}"; do
		_add_song "$i" $eflag
	done
}
